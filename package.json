{
  "name": "auto-apply-ai",
  "version": "2.0.0",
  "description": "Fully automated job application system - Input resume, AI finds and applies to jobs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "node scripts/build-extension.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.0.6",
    "lucide-react": "^0.344.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "idb": "^8.0.0",
    "react-hot-toast": "^2.4.1",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/chrome": "^0.0.260",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "@crxjs/vite-plugin": "^2.0.0-beta.21"
  },
  "keywords": [
    "job-application",
    "automation",
    "ai",
    "resume",
    "career",
    "job-search",
    "linkedin",
    "indeed",
    "chrome-extension"
  ],
  "author": {
    "name": "Siddharth",
    "url": "https://github.com/siddharth3105"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth3105/Auto-Apply-AI.git"
  },
  "bugs": {
    "url": "https://github.com/siddharth3105/Auto-Apply-AI/issues"
  },
  "homepage": "https://github.com/siddharth3105/Auto-Apply-AI#readme"
}
